<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>State Portal Monitor — Fee Schedule Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#060c1a;
  --bg2:#0b1225;
  --bg3:#0f1a30;
  --card:#101c33;
  --card2:#132038;
  --border:#1c2e4a;
  --border2:#243650;
  --blue:#3b82f6;
  --blue-dim:#1d4ed8;
  --cyan:#06b6d4;
  --green:#10b981;
  --amber:#f59e0b;
  --red:#ef4444;
  --purple:#8b5cf6;
  --pink:#ec4899;
  --text:#e2e8f0;
  --text2:#94a3b8;
  --text3:#64748b;
  --mono:'JetBrains Mono',monospace;
  --sans:'Inter',sans-serif;
  --radius:10px;
  --radius-sm:6px;
  --shadow:0 4px 24px rgba(0,0,0,.45);
  --shadow-lg:0 12px 48px rgba(0,0,0,.6);
}
html{font-family:var(--sans);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
body{min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}

/* ── LAYOUT ────────────────────────── */
.shell{display:flex;flex-direction:column;min-height:100vh}

/* ── TOPBAR ────────────────────────── */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 28px;height:60px;
  background:var(--bg2);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:100;
  backdrop-filter:blur(12px);
}
.topbar-brand{display:flex;align-items:center;gap:12px}
.topbar-brand svg{color:var(--blue)}
.topbar-title{font-size:16px;font-weight:700;letter-spacing:-.3px;color:var(--text)}
.topbar-badge{
  font-family:var(--mono);font-size:10px;font-weight:600;
  padding:2px 7px;border-radius:4px;
  background:rgba(59,130,246,.15);color:var(--blue);
  border:1px solid rgba(59,130,246,.25);
  letter-spacing:.5px
}
.topbar-right{display:flex;align-items:center;gap:16px}
.topbar-clock{
  font-family:var(--mono);font-size:12px;color:var(--text3);
  display:flex;align-items:center;gap:6px
}
.pulse-dot{
  width:7px;height:7px;border-radius:50%;background:var(--green);
  box-shadow:0 0 0 0 rgba(16,185,129,.5);
  animation:pulse 2s infinite
}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}
  70%{box-shadow:0 0 0 7px rgba(16,185,129,0)}
  100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}
}
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;border-radius:var(--radius-sm);
  font-size:13px;font-weight:600;cursor:pointer;
  border:1px solid transparent;transition:all .15s ease;
  white-space:nowrap;text-decoration:none
}
.btn-primary{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn-primary:hover{background:#2563eb;border-color:#2563eb;transform:translateY(-1px);box-shadow:0 4px 16px rgba(59,130,246,.35)}
.btn-ghost{background:transparent;color:var(--text2);border-color:var(--border2)}
.btn-ghost:hover{background:var(--card2);color:var(--text);border-color:var(--border2)}
.btn-sm{padding:5px 10px;font-size:11px}
.btn-icon{padding:7px;gap:0}

/* ── MAIN CONTENT ────────────────────────── */
.main{flex:1;padding:24px 28px;display:flex;flex-direction:column;gap:20px}

/* ── STATS BAR ────────────────────────── */
.stats-bar{
  display:grid;grid-template-columns:repeat(5,1fr);gap:12px
}
.stat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:14px 18px;
  display:flex;flex-direction:column;gap:4px;
  position:relative;overflow:hidden;transition:border-color .2s
}
.stat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--accent-color,var(--blue))
}
.stat-card:hover{border-color:var(--border2)}
.stat-label{font-size:11px;font-weight:600;color:var(--text3);letter-spacing:.5px;text-transform:uppercase}
.stat-value{font-size:28px;font-weight:800;line-height:1;color:var(--text);font-variant-numeric:tabular-nums}
.stat-sub{font-family:var(--mono);font-size:11px;color:var(--text3);display:flex;align-items:center;gap:4px}
.stat-sub .up{color:var(--green)}
.stat-sub .down{color:var(--red)}

/* ── TOOLBAR ────────────────────────── */
.toolbar{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap
}
.toolbar-left{display:flex;align-items:center;gap:10px;flex:1}
.search-box{
  position:relative;flex:1;max-width:320px
}
.search-box input{
  width:100%;padding:8px 12px 8px 36px;
  background:var(--card);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--text);font-size:13px;
  font-family:var(--sans);outline:none;transition:all .2s
}
.search-box input::placeholder{color:var(--text3)}
.search-box input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,.15)}
.search-box svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text3);pointer-events:none}
.filter-tabs{display:flex;gap:4px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:3px}
.filter-tab{
  padding:5px 12px;border-radius:4px;font-size:12px;font-weight:600;
  cursor:pointer;transition:all .15s;color:var(--text3);border:none;background:transparent;
  white-space:nowrap
}
.filter-tab.active{background:var(--blue);color:#fff}
.filter-tab:hover:not(.active){background:var(--card2);color:var(--text)}

/* ── TILES GRID ────────────────────────── */
.section-title{font-size:13px;font-weight:700;color:var(--text3);letter-spacing:.5px;text-transform:uppercase;margin-bottom:-4px}
.tiles-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
  gap:14px
}
.state-tile{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius);padding:0;
  cursor:pointer;transition:all .2s ease;overflow:hidden;
  position:relative
}
.state-tile:hover{
  border-color:var(--tile-color,var(--blue));
  transform:translateY(-2px);
  box-shadow:0 8px 32px rgba(0,0,0,.4),0 0 0 1px var(--tile-color,var(--blue))
}
.state-tile.active{
  border-color:var(--tile-color,var(--blue));
  box-shadow:0 8px 32px rgba(0,0,0,.4),0 0 0 1px var(--tile-color,var(--blue))
}
.tile-accent{height:3px;background:var(--tile-color,var(--blue));width:100%}
.tile-body{padding:16px}
.tile-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:14px}
.tile-abbr{
  font-size:32px;font-weight:800;letter-spacing:-1px;
  color:var(--tile-color,var(--blue));line-height:1;font-family:var(--sans)
}
.tile-status-badge{
  display:flex;align-items:center;gap:5px;
  padding:3px 8px;border-radius:20px;font-size:10px;font-weight:700;
  letter-spacing:.3px;text-transform:uppercase;font-family:var(--mono)
}
.status-ok{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.2)}
.status-warn{background:rgba(245,158,11,.12);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
.status-error{background:rgba(239,68,68,.12);color:var(--red);border:1px solid rgba(239,68,68,.2)}
.status-checking{background:rgba(59,130,246,.12);color:var(--blue);border:1px solid rgba(59,130,246,.2)}
.status-dot{width:5px;height:5px;border-radius:50%;background:currentColor}
.tile-name{font-size:13px;font-weight:600;color:var(--text);margin-bottom:2px}
.tile-dept{font-size:11px;color:var(--text3);line-height:1.4}
.tile-metrics{
  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;
  padding-top:14px;border-top:1px solid var(--border)
}
.tile-metric{display:flex;flex-direction:column;align-items:center;gap:2px}
.tile-metric-val{
  font-family:var(--mono);font-size:16px;font-weight:700;color:var(--text);line-height:1
}
.tile-metric-val.warn{color:var(--amber)}
.tile-metric-val.err{color:var(--red)}
.tile-metric-val.ok{color:var(--green)}
.tile-metric-lbl{font-size:10px;color:var(--text3);font-weight:500;text-align:center}
.tile-footer{
  padding:10px 16px;background:var(--bg3);
  border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between
}
.tile-ts{font-family:var(--mono);font-size:10px;color:var(--text3);display:flex;align-items:center;gap:5px}
.tile-action{
  font-size:11px;font-weight:600;color:var(--tile-color,var(--blue));
  display:flex;align-items:center;gap:3px;cursor:pointer
}
.spinning{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── DETAIL PANEL (OVERLAY) ────────────────────────── */
.overlay{
  position:fixed;inset:0;background:rgba(6,12,26,.75);
  z-index:200;opacity:0;pointer-events:none;
  transition:opacity .25s ease;backdrop-filter:blur(6px)
}
.overlay.open{opacity:1;pointer-events:all}
.detail-panel{
  position:fixed;top:0;right:0;bottom:0;width:min(920px,95vw);
  background:var(--bg2);border-left:1px solid var(--border2);
  z-index:201;transform:translateX(100%);
  transition:transform .3s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;overflow:hidden;
  box-shadow:-12px 0 60px rgba(0,0,0,.6)
}
.detail-panel.open{transform:translateX(0)}
.panel-header{
  padding:20px 24px;border-bottom:1px solid var(--border);
  display:flex;align-items:flex-start;justify-content:space-between;
  background:var(--card);flex-shrink:0
}
.panel-header-left{display:flex;align-items:center;gap:14px}
.panel-state-abbr{
  font-size:42px;font-weight:800;line-height:1;letter-spacing:-2px;
  color:var(--panel-color,var(--blue))
}
.panel-info h2{font-size:18px;font-weight:700;color:var(--text);margin-bottom:3px}
.panel-info p{font-size:13px;color:var(--text3)}
.panel-close{
  background:var(--card2);border:1px solid var(--border2);border-radius:var(--radius-sm);
  color:var(--text2);cursor:pointer;padding:8px;transition:all .15s;line-height:0;
  display:flex;align-items:center
}
.panel-close:hover{background:rgba(239,68,68,.15);border-color:rgba(239,68,68,.3);color:var(--red)}
.panel-stats{
  display:flex;gap:0;border-bottom:1px solid var(--border);flex-shrink:0
}
.panel-stat{
  flex:1;padding:12px 20px;text-align:center;border-right:1px solid var(--border);
  display:flex;flex-direction:column;gap:2px
}
.panel-stat:last-child{border-right:none}
.panel-stat-val{font-family:var(--mono);font-size:20px;font-weight:700;color:var(--text)}
.panel-stat-val.warn{color:var(--amber)}
.panel-stat-val.ok{color:var(--green)}
.panel-stat-val.err{color:var(--red)}
.panel-stat-lbl{font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.3px}

/* LOB Tabs */
.lob-tabs-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0
}
.lob-tabs{display:flex;gap:0}
.lob-tab{
  padding:13px 18px;font-size:13px;font-weight:600;cursor:pointer;
  color:var(--text3);border-bottom:2px solid transparent;transition:all .15s;
  white-space:nowrap;border:none;background:transparent;border-bottom:2px solid transparent
}
.lob-tab:hover{color:var(--text)}
.lob-tab.active{color:var(--panel-color,var(--blue));border-bottom-color:var(--panel-color,var(--blue))}
.lob-count{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:18px;height:18px;border-radius:9px;font-size:10px;font-weight:700;
  background:rgba(255,255,255,.08);color:var(--text3);margin-left:5px;padding:0 4px
}
.lob-tab.active .lob-count{background:rgba(59,130,246,.2);color:var(--panel-color,var(--blue))}

/* Panel table */
.panel-body{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:16px}
.panel-table-wrap{
  border:1px solid var(--border);border-radius:var(--radius);overflow:hidden
}
.panel-table{width:100%;border-collapse:collapse;font-size:13px}
.panel-table thead{background:var(--bg3)}
.panel-table th{
  padding:10px 14px;font-size:11px;font-weight:700;color:var(--text3);
  text-align:left;text-transform:uppercase;letter-spacing:.5px;
  border-bottom:1px solid var(--border);white-space:nowrap
}
.panel-table td{
  padding:12px 14px;border-bottom:1px solid var(--border);
  color:var(--text);vertical-align:middle;
}
.panel-table tbody tr:last-child td{border-bottom:none}
.panel-table tbody tr:hover td{background:rgba(255,255,255,.02)}
.sched-name{font-weight:600;color:var(--text);font-size:13px}
.sched-file{font-family:var(--mono);font-size:11px;color:var(--text3);margin-top:2px}
.portal-status{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600}
.portal-status.avail{color:var(--green)}
.portal-status.unavail{color:var(--red)}
.portal-status.checking{color:var(--blue)}
.new-file-badge{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 8px;border-radius:20px;font-size:11px;font-weight:700;
  font-family:var(--mono)
}
.new-file-yes{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.2)}
.new-file-no{background:rgba(100,116,139,.1);color:var(--text3);border:1px solid rgba(100,116,139,.15)}
.comp-badge{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;
  white-space:nowrap;font-family:var(--mono)
}
.comp-matched{background:rgba(16,185,129,.1);color:var(--green)}
.comp-changes{background:rgba(245,158,11,.1);color:var(--amber)}
.comp-pending{background:rgba(139,92,246,.1);color:var(--purple)}
.comp-na{background:rgba(100,116,139,.08);color:var(--text3)}
.comp-error{background:rgba(239,68,68,.1);color:var(--red)}
.dl-btn{
  display:inline-flex;align-items:center;gap:5px;
  padding:5px 10px;border-radius:var(--radius-sm);font-size:11px;font-weight:700;
  cursor:pointer;border:none;transition:all .15s;text-decoration:none;font-family:var(--sans)
}
.dl-diff{background:rgba(245,158,11,.15);color:var(--amber);border:1px solid rgba(245,158,11,.25)}
.dl-diff:hover{background:rgba(245,158,11,.25);transform:translateY(-1px)}
.dl-orig{background:rgba(59,130,246,.12);color:var(--blue);border:1px solid rgba(59,130,246,.2)}
.dl-orig:hover{background:rgba(59,130,246,.22);transform:translateY(-1px)}
.dl-none{color:var(--text3);font-size:11px;font-style:italic}
.run-btn{
  padding:5px 10px;border-radius:var(--radius-sm);font-size:11px;font-weight:600;
  cursor:pointer;border:1px solid var(--border2);background:transparent;color:var(--text2);
  transition:all .15s;display:inline-flex;align-items:center;gap:4px;font-family:var(--sans)
}
.run-btn:hover{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,.08)}
.ts-cell{font-family:var(--mono);font-size:11px;color:var(--text3)}
.changes-count{
  font-family:var(--mono);font-size:13px;font-weight:700;color:var(--amber)
}
.changes-zero{color:var(--text3);font-family:var(--mono);font-size:12px}

/* ── RUN ALL BANNER ────────────────────────── */
.run-banner{
  background:linear-gradient(135deg,rgba(59,130,246,.08),rgba(6,182,212,.08));
  border:1px solid rgba(59,130,246,.2);border-radius:var(--radius);
  padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px
}
.run-banner-text h3{font-size:14px;font-weight:700;color:var(--text);margin-bottom:2px}
.run-banner-text p{font-size:12px;color:var(--text3)}
.run-banner-actions{display:flex;align-items:center;gap:10px}

/* ── ACTIVITY LOG ────────────────────────── */
.activity-row{
  display:flex;align-items:center;gap:10px;padding:8px 0;
  border-bottom:1px solid var(--border);font-size:12px
}
.activity-row:last-child{border-bottom:none}
.activity-icon{
  width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0
}
.activity-green{background:rgba(16,185,129,.12);color:var(--green)}
.activity-amber{background:rgba(245,158,11,.12);color:var(--amber)}
.activity-blue{background:rgba(59,130,246,.12);color:var(--blue)}
.activity-red{background:rgba(239,68,68,.12);color:var(--red)}
.activity-text{flex:1;color:var(--text2)}
.activity-text strong{color:var(--text);font-weight:600}
.activity-ts{font-family:var(--mono);font-size:10px;color:var(--text3);white-space:nowrap}

/* ── EMPTY STATE ────────────────────────── */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:48px;color:var(--text3)}
.empty svg{opacity:.3}
.empty p{font-size:14px;font-weight:500}

/* ── TOAST ────────────────────────── */
.toast-container{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;gap:10px}
.toast{
  display:flex;align-items:center;gap:10px;padding:12px 16px;
  border-radius:var(--radius);border:1px solid;min-width:280px;
  box-shadow:var(--shadow-lg);animation:slideIn .25s ease;font-size:13px;font-weight:500
}
@keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:none;opacity:1}}
.toast-success{background:#0a2818;border-color:rgba(16,185,129,.3);color:var(--green)}
.toast-warn{background:#2a1a06;border-color:rgba(245,158,11,.3);color:var(--amber)}
.toast-info{background:#0a1628;border-color:rgba(59,130,246,.3);color:var(--blue)}

/* ── LOB HEADER ROW ────────────────────────── */
.lob-group-header{
  display:flex;align-items:center;gap:10px;padding:8px 14px;
  background:var(--bg3);border-bottom:1px solid var(--border);
}
.lob-group-name{font-size:11px;font-weight:700;color:var(--text2);letter-spacing:.5px;text-transform:uppercase}
.lob-group-tag{
  padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;
  background:rgba(139,92,246,.12);color:var(--purple);border:1px solid rgba(139,92,246,.2)
}

/* Responsive */
@media(max-width:1100px){
  .stats-bar{grid-template-columns:repeat(3,1fr)}
  .tiles-grid{grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
}
@media(max-width:700px){
  .main{padding:14px 14px}
  .topbar{padding:0 16px}
  .stats-bar{grid-template-columns:repeat(2,1fr)}
  .detail-panel{width:100%}
  .panel-table{font-size:11px}
}
</style>
</head>
<body>

<div class="shell">

<!-- ── TOP BAR ── -->
<header class="topbar">
  <div class="topbar-brand">
    <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
    </svg>
    <span class="topbar-title">State Portal Monitor</span>
    <span class="topbar-badge">FEE SCHEDULES</span>
  </div>
  <div class="topbar-right">
    <div class="topbar-clock">
      <span class="pulse-dot"></span>
      <span id="live-clock">—</span>
    </div>
    <button class="btn btn-ghost btn-sm" onclick="runAllChecks()">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Run All Checks
