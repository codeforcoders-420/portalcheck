        </div>
      </div>
    </div>
    <div class="sched-modal-body">
      <div class="sched-table-section">
        <div class="sched-section-hdr">
          <div>
            <h3>Per-Portal Schedule Settings</h3>
            <p>Configure individually — overrides global defaults per state</p>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex-shrink:0">
            <span style="font-size:12px;color:var(--text3)">Enable All</span>
            <label class="toggle-sw">
