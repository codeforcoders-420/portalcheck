          </svg>
        </div>
        <div>
          <h2>Monitor Schedule Configuration</h2>
          <p>Configure check frequency, run times, and notification settings per state portal</p>
        </div>
      </div>
      <button class="panel-close" onclick="closeScheduleModal()">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
