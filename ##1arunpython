];

function addActivity(text,type){
  activities.unshift({text,type,ts:new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})});
  renderActivity();
}

function renderActivity(){
  const typeMap={green:'activity-green',amber:'activity-amber',blue:'activity-blue',red:'activity-red'};
  const iconMap={
    green:icon('check',13),amber:icon('alert',13),
    blue:icon('file',13),red:icon('x',13)
  };
  document.getElementById('activity-log').innerHTML = activities.slice(0,10).map(a=>`
    <div class="activity-row">
      <div class="activity-icon ${typeMap[a.type]||'activity-blue'}">${iconMap[a.type]||''}</div>
      <div class="activity-text">${a.text}</div>
      <div class="activity-ts">${a.ts}</div>
    </div>`).join('');
}

// ═══════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════
function showToast(msg, type='info'){
  const tc = document.getElementById('toast-container');
  const t = document.createElement('div');
  const cls = type==='warn'?'toast-warn':type==='info'?'toast-info':'toast-success';
  t.className=`toast ${cls}`;
  const ic = type==='warn'?icon('alert',15):type==='info'?icon('file',15):icon('check',15);
  t.innerHTML=`${ic}<span>${msg}</span>`;
  tc.prepend(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(100%)';t.style.transition='all .3s';setTimeout(()=>t.remove(),300);},4500);
}

// ═══════════════════════════════════════════════
// CLOCK
// ═══════════════════════════════════════════════
function updateClock(){
  document.getElementById('live-clock').textContent = new Date().toLocaleString('en-US',{
    month:'short',day:'numeric',year:'numeric',
    hour:'2-digit',minute:'2-digit',second:'2-digit'
  });
}
setInterval(updateClock,1000);
updateClock();

// ═══════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════
renderTiles();
renderActivity();
</script>
