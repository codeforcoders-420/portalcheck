// ═══════════════════════════════════════
// RENDER TILES
// ═══════════════════════════════════════
function renderTiles(){
  const q = document.getElementById('search-input').value.toLowerCase();
  const sort = document.getElementById('sort-sel').value;
  let list = [...STATES];
  if(q) list = list.filter(s=>s.name.toLowerCase().includes(q)||s.id.toLowerCase().includes(q));
  if(currentFilter==='changes') list = list.filter(s=>stateSummary(s).changes>0);
  if(currentFilter==='ok') list = list.filter(s=>stateSummary(s).changes===0);
  if(currentFilter==='error') list = list.filter(s=>stateSummary(s).unavail>0);
  if(sort==='changes') list.sort((a,b)=>stateSummary(b).changes-stateSummary(a).changes);
  else if(sort==='status'){const o={warn:0,error:1,ok:2};list.sort((a,b)=>o[stateSummary(a).tileStatus]-o[stateSummary(b).tileStatus]);}
  else list.sort((a,b)=>a.name.localeCompare(b.name));

  const grid = document.getElementById('tiles-grid');
  if(!list.length){
    grid.innerHTML=`<div class="empty" style="grid-column:1/-1">${ico('eye',32)}<p>No portals match your filter</p></div>`;
    return;
  }
  grid.innerHTML = list.map(s=>{
    const {newFiles,changes,unavail,tileStatus} = stateSummary(s);
    const sc = tileStatus==='warn'?'status-warn':tileStatus==='error'?'status-error':'status-ok';
    const vc = changes>0?'warn':unavail>0?'err':'ok';
    return `
    <div class="state-tile" style="--tile-color:${s.color}" onclick="openDetailModal('${s.id}')">
      <div class="tile-accent"></div>
      <div class="tile-body">
        <div class="tile-header">
          <div class="tile-abbr">${s.id}</div>
          <div class="tile-status-badge ${sc}"><div class="status-dot"></div>${statusLabel(tileStatus)}</div>
        </div>
        <div class="tile-name">${s.name}</div>
        <div class="tile-dept">${s.dept}</div>
        <div class="tile-metrics">
          <div class="tile-metric"><div class="tile-metric-val">${stateSummary(s).total}</div><div class="tile-metric-lbl">Schedules</div></div>
          <div class="tile-metric"><div class="tile-metric-val ${newFiles>0?'warn':''}">${newFiles}</div><div class="tile-metric-lbl">New Files</div></div>
          <div class="tile-metric"><div class="tile-metric-val ${vc}">${changes}</div><div class="tile-metric-lbl">Changes</div></div>
        </div>
      </div>
      <div class="tile-footer">
        <div class="tile-ts">${ico('clock',11)} ${s.lastChecked}</div>
        <div class="tile-action-row">${ico('eye',11)} View Details</div>
      </div>
    </div>`;
  }).join('');
}

function setFilter(f, el){
  currentFilter = f;
  document.querySelectorAll('.filter-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderTiles();
}

// ═══════════════════════════════════════
// DETAIL CENTER MODAL
// ═══════════════════════════════════════
function openDetailModal(id){
  const s = STATES.find(x=>x.id===id);
  if(!s) return;
  currentState = s;

  document.getElementById('detail-modal').style.setProperty('--panel-color', s.color);
  document.getElementById('panel-abbr').textContent = s.id;
  document.getElementById('panel-name').textContent = s.name;
  document.getElementById('panel-dept').textContent = s.dept;

  const all = s.lobs.flatMap(l=>l.schedules);
  document.getElementById('ps-total').textContent = all.length;
  document.getElementById('ps-avail').textContent = all.filter(x=>x.portal).length;
  document.getElementById('ps-new').textContent = all.filter(x=>x.newFile).length;
  document.getElementById('ps-changes').textContent = all.filter(x=>x.compStatus==='changes').length;
  document.getElementById('ps-lobs').textContent = s.lobs.length;

  currentLob = s.lobs[0].id;
  const tabsEl = document.getElementById('lob-tabs');
  tabsEl.innerHTML = s.lobs.map(l=>`
    <button class="lob-tab${l.id===currentLob?' active':''}" onclick="switchLob('${l.id}',this)">
      ${l.name}<span class="lob-count">${l.schedules.length}</span>
    </button>`).join('');

  renderPanelTable(s, currentLob);
  openModal('detail-overlay');
}

function switchLob(lobId, el){
  currentLob = lobId;
  document.querySelectorAll('.lob-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderPanelTable(currentState, lobId);
}

function renderPanelTable(s, lobId){
  const lob = s.lobs.find(l=>l.id===lobId);
  if(!lob) return;

  const rows = lob.schedules.map(sch=>{
    const portalHtml = sch.portal
      ? `<span class="portal-badge avail">${ico('check',13)} Available</span>`
      : `<span class="portal-badge unavail">${ico('x',13)} Unavailable</span>`;

    const newHtml = sch.newFile
      ? `<span class="new-file-tag new-yes">${ico('check',11)} Found · ${sch.newDate}</span>`
      : `<span class="new-file-tag new-no">— None</span>`;

    const cs = sch.compStatus;
    let compHtml = '';
    if(cs==='changes') compHtml=`<span class="comp-tag comp-changes">${ico('alert',11)} Changes Found</span>`;
    else if(cs==='matched') compHtml=`<span class="comp-tag comp-matched">${ico('check',11)} Matched</span>`;
    else if(cs==='pending') compHtml=`<span class="comp-tag comp-pending">${ico('clock',11)} Pending</span>`;
    else compHtml=`<span class="comp-tag comp-na">N/A</span>`;

    const chgHtml = cs==='changes'
      ? `<span class="changes-count">+${sch.changes.toLocaleString()}</span>`
      : `<span class="changes-none">—</span>`;

    const diffHtml = sch.diffFile
      ? `<button class="dl-btn dl-diff" onclick="dlFile('${sch.diffFile}','diff')">${ico('dl',11)} Diff File</button>`
      : `<span class="dl-none">—</span>`;

    const srcHtml = sch.portal
      ? `<button class="dl-btn dl-orig" onclick="dlFile('${sch.file}','source')">${ico('dl',11)} Source</button>`
      : `<span class="dl-none">Unavailable</span>`;

    return `
    <tr>
      <td>
        <div class="sched-name">${sch.name}</div>
        <div class="sched-file">${sch.file}</div>
        ${sch.fileSize?`<div class="sched-size">${sch.fileSize}</div>`:''}
      </td>
      <td>${portalHtml}</td>
      <td class="ts-cell">${s.lastChecked}</td>
      <td>${newHtml}</td>
      <td>${compHtml}</td>
      <td>${chgHtml}</td>
      <td>${diffHtml}</td>
      <td>${srcHtml}</td>
      <td>
        <button class="run-btn" onclick="runSingleCheck(this,'${sch.id}')">
          ${ico('refresh',11)} Check
        </button>
      </td>
    </tr>`;
  }).join('');

  document.getElementById('panel-body').innerHTML = `
    <div class="panel-table-wrap">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fee Schedule</th>
            <th>Portal Status</th>
            <th>Last Checked</th>
            <th>New File</th>
            <th>Comparison</th>
            <th># Changes</th>
            <th>Diff File</th>
            <th>Source File</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
}

function closeDetailModal(){ closeModal('detail-overlay'); currentState=null; }

// ═══════════════════════════════════════
// SCHEDULE CONFIG MODAL
// ═══════════════════════════════════════
const DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
const FREQS = [
  {val:'hourly',label:'Every 6 Hours'},
  {val:'twice',label:'Twice Daily'},
  {val:'daily',label:'Daily'},
  {val:'weekdays',label:'Weekdays Only'},
  {val:'weekly',label:'Weekly'},
  {val:'monthly',label:'Monthly'},
];

function nextRunLabel(cfg){
  const now = new Date();
  const [h,m] = cfg.time.split(':').map(Number);
  const next = new Date();
  next.setHours(h,m,0,0);
  if(next<=now) next.setDate(next.getDate()+1);
  const diff = Math.round((next-now)/60000);
  if(diff<60) return `in ${diff}m`;
  return `in ${Math.round(diff/60)}h ${diff%60}m`;
}

function openScheduleModal(){
  renderSchedTable();
  openModal('schedule-overlay');
}

function closeScheduleModal(){ closeModal('schedule-overlay'); }

function renderSchedTable(){
  const tbody = document.getElementById('sched-table-body');
  tbody.innerHTML = STATES.map(s=>{
    const cfg = schedConfig[s.id];
    const daysCbs = DAYS.map(d=>`
      <input type="checkbox" class="day-cb" id="day-${s.id}-${d}" ${cfg.days.includes(d)?'checked':''}
        onchange="updateDay('${s.id}','${d}',this.checked)">
      <label class="day-lbl" for="day-${s.id}-${d}">${d.slice(0,1)}</label>
    `).join('');

    const freqOpts = FREQS.map(f=>`<option value="${f.val}" ${cfg.freq===f.val?'selected':''}>${f.label}</option>`).join('');

    return `
    <tr>
      <td>
        <div class="sched-state-abbr">
          <span class="sched-state-dot" style="background:${s.color}"></span>
          ${s.id}
          <span style="font-size:12px;font-weight:500;color:var(--text3)">${s.name}</span>
        </div>
      </td>
      <td>
        <label class="toggle-sw">
          <input type="checkbox" ${cfg.enabled?'checked':''} onchange="updateEnabled('${s.id}',this.checked)">
          <span class="slider"></span>
        </label>
      </td>
      <td>
        <select class="form-select" style="font-size:12px;padding:5px 8px" onchange="updateFreq('${s.id}',this.value)">
          ${freqOpts}
        </select>
      </td>
      <td>
        <input type="time" class="form-input" value="${cfg.time}" style="font-size:12px;padding:5px 8px;width:100px"
          onchange="updateTime('${s.id}',this.value)">
      </td>
      <td><div class="days-row">${daysCbs}</div></td>
      <td>
        <input type="email" class="form-input" value="${cfg.email}" placeholder="email@org.com"
          style="font-size:12px;padding:5px 8px;min-width:160px"
          onchange="updateEmail('${s.id}',this.value)">
      </td>
      <td>
        <span class="freq-badge" style="font-size:10px">${cfg.enabled?nextRunLabel(cfg):'Disabled'}</span>
      </td>
    </tr>`;
  }).join('');
}

function updateEnabled(id, val){ schedConfig[id].enabled = val; }
function updateFreq(id, val){ schedConfig[id].freq = val; }
function updateTime(id, val){ schedConfig[id].time = val; }
function updateEmail(id, val){ schedConfig[id].email = val; }
function updateDay(id, day, checked){
  const days = schedConfig[id].days;
  if(checked && !days.includes(day)) days.push(day);
  if(!checked) schedConfig[id].days = days.filter(d=>d!==day);
}

function applyGlobalFreq(){
  const val = document.getElementById('global-freq').value;
  STATES.forEach(s=>schedConfig[s.id].freq = val);
}
function applyGlobalTime(){
  const val = document.getElementById('global-time').value;
  STATES.forEach(s=>schedConfig[s.id].time = val);
}
function applyGlobalToAll(){
  applyGlobalFreq(); applyGlobalTime();
  renderSchedTable();
  showToast('Global settings applied to all 11 portals.','info');
}

function toggleAllPortals(checked){
  STATES.forEach(s=>schedConfig[s.id].enabled = checked);
  document.querySelectorAll('#sched-table-body input[type="checkbox"]').forEach(cb=>{
    if(cb!==document.getElementById('enable-all-toggle')) cb.checked=checked;
  });
}

function saveSchedule(){
  closeScheduleModal();
  const enabled = STATES.filter(s=>schedConfig[s.id].enabled).length;
  showToast(`Schedule saved — ${enabled} of 11 portals active.`,'info');
  addActivity(`<strong>Schedule updated</strong> — ${enabled} portals active, next run configured`, 'blue');
}

// ═══════════════════════════════════════
// MODAL HELPERS
// ═══════════════════════════════════════
function openModal(overlayId){
  document.getElementById(overlayId).classList.add('open');
  document.body.style.overflow='hidden';
}
function closeModal(overlayId){
  document.getElementById(overlayId).classList.remove('open');
  document.body.style.overflow='';
}
function handleOverlayClick(e, overlayId){
  if(e.target.id===overlayId){
    if(overlayId==='detail-overlay') closeDetailModal();
    else if(overlayId==='schedule-overlay') closeScheduleModal();
  }
}
document.addEventListener('keydown', e=>{
  if(e.key==='Escape'){
    closeDetailModal();
    closeScheduleModal();
  }
});

// ═══════════════════════════════════════
// ACTIONS
// ═══════════════════════════════════════
function dlFile(fname, type){
  showToast(`${type==='diff'?'Diff':'Source'} file download started: ${fname}`,'info');
}

function runSingleCheck(btn, schedId){
  btn.disabled=true;
  btn.innerHTML=`<svg class="spinning" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Checking…`;
  setTimeout(()=>{
    btn.disabled=false;
    btn.innerHTML=`${ico('refresh',11)} Check`;
    showToast('Check complete — no new file detected.','info');
  },2200);
}

function runStateCheck(){
  if(!currentState) return;
  const s = currentState;
  showToast(`Running check on ${s.name} — ${s.lobs.flatMap(l=>l.schedules).length} schedules…`,'info');
  setTimeout(()=>{ showToast(`${s.name} re-check complete.`,'info'); },3000);
}

function runAllChecks(){
  const icon = document.getElementById('run-all-icon');
  icon.classList.add('spinning');
  showToast('Running full check on all 11 portals…','info');
  STATES.forEach((s,i)=>{
    setTimeout(()=>{
      const {changes,newFiles,unavail} = stateSummary(s);
      const type = changes>0?'amber':unavail>0?'red':'green';
      addActivity(
        `<strong>${s.id} (${s.name})</strong> — check complete · ${newFiles} new file(s) · ${changes} change(s)`,
        type
      );
    }, i*300);
  });
  setTimeout(()=>{
    icon.classList.remove('spinning');
    showToast('All 11 portals checked — 8 changes detected.','warn');
  }, STATES.length*300+400);
}

