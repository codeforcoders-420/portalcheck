"SELECT DISTINCT AFF.pay_class, AFF.PROV_NBR, ADDR.CITY, ADDR.STATE, ADDR.ZIP ,PROV.FIRSTNAME||PROV.LASTNAME as PROV_NAME, PROV.INSTNAME,
AFF.IRS_NBR,PROV.NPI,SERV.aff_nbr, 
CASE
WHEN CLM.CLAIM_TYPE = 'M' THEN  'H'
WHEN CLM.CLAIM_TYPE = 'H' THEN  'U'
END AS CLAIM_TYPE,TRIM(BILL.UB_FAC)||TRIM(BILL.UB_BILLCLASS)||TRIM(BILL.UB_FRQ) AS TYPE_OF_BILL,SERV.SEX,
CLM.DIAG_NBR,CLM.DIAG2_NBR,CLM.DIAG3_NBR,CLM.DIAG4_NBR,CLM.DIAG5_NBR,
DP.CL_DIAG_ARRAY_1,DP.CL_DIAG_ARRAY_2,DP.CL_DIAG_ARRAY_3,DP.CL_DIAG_ARRAY_4,DP.CL_DIAG_ARRAY_5,DP.CL_DIAG_ARRAY_6,DP.CL_DIAG_ARRAY_7,
DP.CL_DIAG_ARRAY_8,DP.CL_DIAG_ARRAY_9,DP.CL_DIAG_ARRAY_10,
CLM.PROC_NBR,CLM.PROC2_NBR,CLM.PROC3_NBR,CLM.PROC4_NBR,CLM.PROC5_NBR,
DP.CL_PROC_ARRAY_1,DP.CL_PROC_ARRAY_2,DP.CL_PROC_ARRAY_3,DP.CL_PROC_ARRAY_4,
DP.CL_PROC_ARRAY_5,DP.CL_PROC_ARRAY_6,DP.CL_PROC_ARRAY_7,DP.CL_PROC_ARRAY_8,DP.CL_PROC_ARRAY_9,DP.CL_PROC_ARRAY_10,CLM.DRG_NBR,UBD.POA_INDICATOR,
CLM.* FROM AMIOWN.CLAIM CLM
JOIN AMIOWN.SERVICE_X SERV ON SERV.CLAIM_NBR = CLM.CLAIM_NBR
JOIN AMIOWN.AFFILIATION AFF ON AFF.AFF_NBR = SERV.AFF_NBR
JOIN AMIOWN.PROVIDER PROV ON PROV.PROV_NBR = AFF.PROV_NBR
LEFT JOIN AMIOWN.UB BILL ON BILL.CLAIM_NBR = SERV.CLAIM_NBR
LEFT JOIN AMIOWN.UB_DIAGNOSIS UBD ON UBD.CLAIM_NBR=CLM.CLAIM_NBR
JOIN AMIOWN.ADDRESS ADDR ON TRIM(PROV.PROV_NBR) = (SUBSTR(ADDR.ADDR_WHO,3,6))
LEFT JOIN AMIOWN.CLAIM_D_P DP ON DP.CLAIM_NBR=CLM.CLAIM_NBR
WHERE CLM.YMDCOV_EFF_DATE > '20190915' AND  SERV.SERV_NBR LIKE '%00' and ADDR.ADDR_WHO LIKE 'P%'
AND AFF.YMDEND = '99991231' and AFF.PAY_CLASS = '900029' AND AFF.PROV_NBR = '900029' 
AND SERV.BUSINESS_UNIT NOT IN ('BX','BS') 
AND AFF.CLASS_X NOT IN ('ML','MX','MP')  AND AFF.VOID NOT IN ('V')
ORDER BY CLM.CLAIM_NBR ASC"



