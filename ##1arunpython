  {text:'<strong>CMS</strong> — Medicare Physician Fee Schedule diff file generated · 2,841 changes', type:'amber', ts:'08:42 AM'},
  {text:'<strong>GA</strong> — Outpatient Hospital Fee Schedule new file downloaded · comparison running', type:'blue', ts:'08:38 AM'},
