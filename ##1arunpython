        { id:'wv-m-2', name:'Laboratory Fee Schedule', file:'WV_Medicaid_Lab_2026.xlsx', prev:'WV_Medicaid_Lab_2025.xlsx', portal:true, newFile:false, newDate:null, compStatus:'na', changes:0, diffFile:null, fileSize:'890 KB' },
        { id:'wv-m-3', name:'DMEPOS Fee Schedule', file:'WV_Medicaid_DMEPOS_2026.xlsx', prev:null, portal:false, newFile:false, newDate:null, compStatus:'na', changes:0, diffFile:null, fileSize:null },
      ]},
    ]
  },
];

// ═══════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════
let currentFilter = 'all';
let currentState = null;
let currentLob = null;

function stateSummary(s){
  const allSched = s.lobs.flatMap(l=>l.schedules);
  const newFiles = allSched.filter(x=>x.newFile).length;
  const changes = allSched.filter(x=>x.compStatus==='changes').length;
  const unavail = allSched.filter(x=>!x.portal).length;
  const pending = allSched.filter(x=>x.compStatus==='pending').length;
  const total = allSched.length;
  let tileStatus = 'ok';
  if(changes>0) tileStatus='warn';
  if(unavail===total) tileStatus='error';
  return {newFiles,changes,unavail,pending,total,tileStatus};
}

function statusLabel(s){
  if(s==='warn') return 'Changes Found';
  if(s==='error') return 'Unavailable';
  return 'All Clear';
}

function icon(name,size=14){
  const icons={
    check:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`,
    x:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>`,
    dl:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>`,
    clock:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" d="M12 6v6l4 2"/></svg>`,
    refresh:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
    alert:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`,
    file:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
    eye:`<svg width="${size}" height="${size}" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`,
  };
  return icons[name]||'';
}

// ═══════════════════════════════════════════════
// RENDER TILES
// ═══════════════════════════════════════════════
function renderTiles(){
  const q = document.getElementById('search-input').value.toLowerCase();
  const sort = document.getElementById('sort-sel').value;
  let list = [...STATES];

  if(q) list=list.filter(s=>s.name.toLowerCase().includes(q)||s.id.toLowerCase().includes(q));
  if(currentFilter==='changes') list=list.filter(s=>stateSummary(s).changes>0);
  if(currentFilter==='ok') list=list.filter(s=>stateSummary(s).changes===0&&stateSummary(s).unavail<stateSummary(s).total);
  if(currentFilter==='error') list=list.filter(s=>stateSummary(s).unavail>0);

  if(sort==='changes') list.sort((a,b)=>stateSummary(b).changes-stateSummary(a).changes);
  else if(sort==='status'){
    const ord={warn:0,error:1,ok:2};
    list.sort((a,b)=>ord[stateSummary(a).tileStatus]-ord[stateSummary(b).tileStatus]);
  } else {
    list.sort((a,b)=>a.name.localeCompare(b.name));
  }

  const grid = document.getElementById('tiles-grid');
  if(!list.length){
    grid.innerHTML=`<div class="empty" style="grid-column:1/-1">${icon('eye',36)}<p>No portals match your filter</p></div>`;
    return;
  }

  grid.innerHTML = list.map(s=>{
    const {newFiles,changes,unavail,tileStatus,total} = stateSummary(s);
    const statClass = tileStatus==='warn'?'status-warn':tileStatus==='error'?'status-error':'status-ok';
    const valClass = changes>0?'warn':unavail>0?'err':'ok';
    return `
    <div class="state-tile${currentState&&currentState.id===s.id?' active':''}" style="--tile-color:${s.color}" onclick="openPanel('${s.id}')">
      <div class="tile-accent"></div>
      <div class="tile-body">
        <div class="tile-header">
          <div class="tile-abbr">${s.id}</div>
          <div class="tile-status-badge ${statClass}">
            <div class="status-dot"></div>
            ${statusLabel(tileStatus)}
          </div>
        </div>
        <div class="tile-name">${s.name}</div>
        <div class="tile-dept">${s.dept}</div>
        <div class="tile-metrics">
          <div class="tile-metric">
            <div class="tile-metric-val">${total}</div>
            <div class="tile-metric-lbl">Schedules</div>
          </div>
          <div class="tile-metric">
            <div class="tile-metric-val ${newFiles>0?'warn':''}">${newFiles}</div>
            <div class="tile-metric-lbl">New Files</div>
          </div>
          <div class="tile-metric">
            <div class="tile-metric-val ${valClass}">${changes}</div>
            <div class="tile-metric-lbl">Changes</div>
          </div>
        </div>
      </div>
      <div class="tile-footer">
        <div class="tile-ts">${icon('clock',11)} ${s.lastChecked}</div>
        <div class="tile-action">${icon('eye',12)} View Details</div>
      </div>
    </div>`;
  }).join('');
}

function filterTiles(){ renderTiles(); }

function setFilter(f, el){
  currentFilter=f;
  document.querySelectorAll('.filter-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderTiles();
}

// ═══════════════════════════════════════════════
// DETAIL PANEL
// ═══════════════════════════════════════════════
function openPanel(id){
  const s = STATES.find(x=>x.id===id);
  if(!s) return;
  currentState = s;

  // Set panel color
  document.getElementById('detail-panel').style.setProperty('--panel-color',s.color);

  // Header
  document.getElementById('panel-abbr').textContent = s.id;
  document.getElementById('panel-name').textContent = s.name;
  document.getElementById('panel-dept').textContent = s.dept;

  // Stats
  const all = s.lobs.flatMap(l=>l.schedules);
  document.getElementById('ps-total').textContent = all.length;
  document.getElementById('ps-avail').textContent = all.filter(x=>x.portal).length;
  document.getElementById('ps-new').textContent = all.filter(x=>x.newFile).length;
  document.getElementById('ps-changes').textContent = all.filter(x=>x.compStatus==='changes').length;
  document.getElementById('ps-lobs').textContent = s.lobs.length;

  // LOB Tabs
  currentLob = s.lobs[0].id;
  const tabsEl = document.getElementById('lob-tabs');
  tabsEl.innerHTML = s.lobs.map(l=>`
    <button class="lob-tab${l.id===currentLob?' active':''}" onclick="switchLob('${l.id}',this,'${s.id}')">
      ${l.name}<span class="lob-count">${l.schedules.length}</span>
    </button>`).join('');

  renderPanelTable(s, currentLob);

  document.getElementById('overlay').classList.add('open');
  document.getElementById('detail-panel').classList.add('open');
  renderTiles();
}

function switchLob(lobId, el, stateId){
  currentLob = lobId;
  document.querySelectorAll('.lob-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  const s = STATES.find(x=>x.id===stateId);
  renderPanelTable(s, lobId);
}

function renderPanelTable(s, lobId){
  const lob = s.lobs.find(l=>l.id===lobId);
  if(!lob) return;
  const body = document.getElementById('panel-body');

  const rows = lob.schedules.map(sch=>{
    // Portal status
    let portalHtml;
    if(sch.portal){
      portalHtml=`<span class="portal-status avail">${icon('check',13)} Available</span>`;
    } else {
      portalHtml=`<span class="portal-status unavail">${icon('x',13)} Unavailable</span>`;
    }

    // New file
    let newHtml;
    if(sch.newFile){
      newHtml=`<span class="new-file-badge new-file-yes">${icon('check',11)} Found · ${sch.newDate}</span>`;
    } else {
      newHtml=`<span class="new-file-badge new-file-no">— None</span>`;
    }

    // Comparison
    let compHtml;
    const cs = sch.compStatus;
    if(cs==='changes') compHtml=`<span class="comp-badge comp-changes">${icon('alert',11)} Changes Found</span>`;
    else if(cs==='matched') compHtml=`<span class="comp-badge comp-matched">${icon('check',11)} Matched</span>`;
    else if(cs==='pending') compHtml=`<span class="comp-badge comp-pending">${icon('clock',11)} Pending</span>`;
    else if(cs==='error') compHtml=`<span class="comp-badge comp-error">${icon('x',11)} Error</span>`;
    else compHtml=`<span class="comp-badge comp-na">N/A</span>`;

    // Changes count
    let chgHtml;
    if(cs==='changes') chgHtml=`<span class="changes-count">+${sch.changes.toLocaleString()}</span>`;
    else chgHtml=`<span class="changes-zero">—</span>`;

    // Diff download
    let diffHtml;
    if(sch.diffFile){
      diffHtml=`<button class="dl-btn dl-diff" onclick="downloadFile('${sch.diffFile}','diff')">${icon('dl',11)} ${sch.diffFile}</button>`;
    } else {
      diffHtml=`<span class="dl-none">—</span>`;
    }

    // Source download
    let srcHtml;
    if(sch.portal && sch.file){
      srcHtml=`<button class="dl-btn dl-orig" onclick="downloadFile('${sch.file}','source')">${icon('dl',11)} Source</button>`;
    } else {
      srcHtml=`<span class="dl-none">Unavailable</span>`;
    }

    return `
    <tr>
      <td>
        <div class="sched-name">${sch.name}</div>
        <div class="sched-file">${sch.file||'—'}</div>
        ${sch.fileSize?`<div style="font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:1px">${sch.fileSize}</div>`:''}
      </td>
      <td>${portalHtml}</td>
      <td class="ts-cell">${s.lastChecked}</td>
      <td>${newHtml}</td>
      <td>${compHtml}</td>
      <td>${chgHtml}</td>
      <td>${diffHtml}</td>
      <td>${srcHtml}</td>
      <td>
        <button class="run-btn" onclick="runSingleCheck('${sch.id}',this)">
          ${icon('refresh',11)} Check
        </button>
      </td>
    </tr>`;
  }).join('');

  body.innerHTML=`
    <div class="panel-table-wrap">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fee Schedule</th>
            <th>Portal Status</th>
            <th>Last Checked</th>
            <th>New File</th>
            <th>Comparison</th>
            <th># Changes</th>
            <th>Diff File</th>
            <th>Source File</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
}

function closePanel(){
  document.getElementById('overlay').classList.remove('open');
  document.getElementById('detail-panel').classList.remove('open');
  currentState = null;
  renderTiles();
}

// ═══════════════════════════════════════════════
// ACTIONS
// ═══════════════════════════════════════════════
function downloadFile(fname, type){
  showToast(`${type==='diff'?'Diff':'Source'} file "${fname}" download started.`, type==='diff'?'warn':'info');
}

function runSingleCheck(schedId, btn){
  btn.disabled=true;
  btn.innerHTML=`<svg class="spinning" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Checking…`;
  setTimeout(()=>{
    btn.disabled=false;
    btn.innerHTML=`${icon('refresh',11)} Check`;
    showToast('Check complete — no new file detected.','info');
  },2200);
}

function runStateCheck(s){
  if(!s) return;
  showToast(`Running full check on ${s.name} — ${s.lobs.flatMap(l=>l.schedules).length} schedules…`,'info');
  setTimeout(()=>showToast(`${s.name} check complete.`,'info'),3500);
}

function runAllChecks(){
  const btn = document.getElementById('run-icon');
  btn.classList.add('spinning');
  showToast('Running full check on all 11 portals — 47 fee schedules…','info');
  let d=1;
  STATES.forEach((s,i)=>{
    setTimeout(()=>{
      addActivity(`<strong>${s.id} (${s.name})</strong> — check complete · ${s.lobs.flatMap(l=>l.schedules).filter(x=>x.newFile).length} new file(s) found`,
        stateSummary(s).changes>0?'amber':stateSummary(s).unavail>0?'red':'green');
    }, i*320);
  });
  setTimeout(()=>{
    btn.classList.remove('spinning');
    showToast('All portals checked. 8 changes detected.','warn');
  }, STATES.length*320+400);
}

