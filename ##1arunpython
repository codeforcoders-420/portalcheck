        <span class="theme-toggle-sun">☀️</span>
        <span class="theme-toggle-moon">🌙</span>
      </div>
      <div class="theme-toggle-thumb"></div>
    </div>
    <button class="btn btn-ghost btn-sm" onclick="runAllChecks()">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" id="run-all-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Run All
    </button>
    <button class="btn btn-primary btn-sm" onclick="showToast('Report export started — 11 portals, 47 schedules.','info')">
      <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
      </svg>
      Export
    </button>
  </div>
</header>

<!-- MAIN -->
<main class="main">

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stat-card" style="--accent-color:var(--blue)">
      <div class="stat-label">Portals Monitored</div>
      <div class="stat-value">11</div>
      <div class="stat-sub">MI · NV · MS · GA · CMS · KY · TC · AR · OH · WI · WV</div>
    </div>
    <div class="stat-card" style="--accent-color:var(--green)">
      <div class="stat-label">Files Checked Today</div>
      <div class="stat-value">47</div>
      <div class="stat-sub"><span class="up">↑ 3</span>&nbsp;from yesterday</div>
    </div>
    <div class="stat-card" style="--accent-color:var(--amber)">
      <div class="stat-label">New Files Found</div>
      <div class="stat-value">12</div>
      <div class="stat-sub"><span class="up">↑ 12</span>&nbsp;since last run</div>
    </div>
    <div class="stat-card" style="--accent-color:var(--red)">
      <div class="stat-label">Changes Detected</div>
      <div class="stat-value">8</div>
      <div class="stat-sub"><span class="down">!</span>&nbsp;require review</div>
    </div>
    <div class="stat-card" style="--accent-color:var(--purple)">
      <div class="stat-label">Last Full Scan</div>
      <div class="stat-value" style="font-size:20px;padding-top:4px">08:30 AM</div>
      <div class="stat-sub">Jul 06, 2026 · All portals</div>
    </div>
  </div>

  <!-- Run Banner -->
  <div class="run-banner">
    <div class="run-banner-text">
      <h3>Daily Scheduled Check — Next Run at 06:00 PM ET</h3>
      <p>Automated comparison and diff file generation enabled · 11 portals active · 47 fee schedules tracked</p>
    </div>
    <div class="run-banner-actions">
      <button class="btn btn-ghost btn-sm" onclick="openScheduleModal()">
        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Configure Schedule
      </button>
      <button class="btn btn-primary btn-sm" onclick="runAllChecks()">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
        Run Now
      </button>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="toolbar">
    <div class="toolbar-left">
      <div class="search-box">
        <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
        </svg>
        <input type="text" placeholder="Search state portals…" id="search-input" oninput="renderTiles()"/>
      </div>
      <div class="filter-tabs">
