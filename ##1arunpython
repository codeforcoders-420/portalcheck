      <div class="panel-stat"><div class="panel-stat-val err" id="ps-changes">—</div><div class="panel-stat-lbl">Changes</div></div>
      <div class="panel-stat"><div class="panel-stat-val" id="ps-lobs">—</div><div class="panel-stat-lbl">LOBs</div></div>
