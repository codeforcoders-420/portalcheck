<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>State Portal Monitor — Fee Schedule Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

/* ── DARK THEME (default) ── */
[data-theme="dark"]{
  --bg:#060c1a;
  --bg2:#0b1225;
  --bg3:#0f1a30;
  --card:#101c33;
  --card2:#132038;
  --border:#1c2e4a;
  --border2:#243650;
  --blue:#3b82f6;
  --cyan:#06b6d4;
  --green:#10b981;
  --amber:#f59e0b;
  --red:#ef4444;
  --purple:#8b5cf6;
  --pink:#ec4899;
  --text:#e2e8f0;
  --text2:#94a3b8;
  --text3:#64748b;
  --shadow:0 4px 24px rgba(0,0,0,.45);
  --shadow-lg:0 12px 48px rgba(0,0,0,.65);
  --overlay-bg:rgba(6,12,26,.82);
  --toggle-icon:"☀️";
  --topbar-glow:rgba(59,130,246,.06);
}

/* ── LIGHT THEME ── */
[data-theme="light"]{
  --bg:#f0f4fa;
  --bg2:#ffffff;
  --bg3:#e8edf5;
  --card:#ffffff;
  --card2:#f5f8fc;
  --border:#d1dae8;
  --border2:#bac6d8;
  --blue:#2563eb;
  --cyan:#0891b2;
  --green:#059669;
  --amber:#d97706;
  --red:#dc2626;
  --purple:#7c3aed;
  --pink:#db2777;
  --text:#0f172a;
  --text2:#374151;
  --text3:#6b7280;
  --shadow:0 4px 24px rgba(0,0,0,.10);
  --shadow-lg:0 12px 48px rgba(0,0,0,.18);
  --overlay-bg:rgba(15,23,42,.60);
  --toggle-icon:"🌙";
  --topbar-glow:rgba(37,99,235,.04);
}

html{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;transition:background .3s,color .3s}
body{min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}

/* ── LAYOUT ── */
.shell{display:flex;flex-direction:column;min-height:100vh}

/* ── TOPBAR ── */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 28px;height:60px;
  background:var(--bg2);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:100;
  backdrop-filter:blur(12px);
  box-shadow:0 1px 0 var(--border);
}
.topbar-brand{display:flex;align-items:center;gap:12px}
.topbar-brand svg{color:var(--blue)}
.topbar-title{font-size:16px;font-weight:700;letter-spacing:-.3px;color:var(--text)}
.topbar-badge{
  font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;
  padding:2px 7px;border-radius:4px;
  background:rgba(59,130,246,.13);color:var(--blue);
  border:1px solid rgba(59,130,246,.22);letter-spacing:.5px
}
.topbar-right{display:flex;align-items:center;gap:12px}
.topbar-clock{
  font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text3);
  display:flex;align-items:center;gap:6px
}
.pulse-dot{
  width:7px;height:7px;border-radius:50%;background:var(--green);
  box-shadow:0 0 0 0 rgba(16,185,129,.5);
  animation:pulse-anim 2s infinite
}
@keyframes pulse-anim{
  0%{box-shadow:0 0 0 0 rgba(16,185,129,.5)}
  70%{box-shadow:0 0 0 7px rgba(16,185,129,0)}
  100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}
}

/* ── THEME TOGGLE ── */
.theme-toggle{
  display:flex;align-items:center;gap:0;
  background:var(--bg3);border:1px solid var(--border2);
  border-radius:20px;padding:3px;cursor:pointer;transition:all .2s;
  position:relative;width:68px;height:30px;flex-shrink:0
}
.theme-toggle-track{
  position:relative;width:100%;height:100%;display:flex;
  align-items:center;justify-content:space-between;padding:0 7px
}
.theme-toggle-sun,.theme-toggle-moon{font-size:13px;z-index:1;transition:opacity .2s;line-height:1}
[data-theme="light"] .theme-toggle-sun{opacity:1}
[data-theme="light"] .theme-toggle-moon{opacity:.35}
[data-theme="dark"] .theme-toggle-sun{opacity:.35}
[data-theme="dark"] .theme-toggle-moon{opacity:1}
.theme-toggle-thumb{
  position:absolute;top:2px;width:22px;height:22px;border-radius:50%;
  background:var(--blue);box-shadow:0 2px 8px rgba(0,0,0,.3);
  transition:transform .25s cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"] .theme-toggle-thumb{transform:translateX(38px)}
[data-theme="light"] .theme-toggle-thumb{transform:translateX(2px)}

/* ── BUTTONS ── */
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;border-radius:6px;
  font-size:13px;font-weight:600;cursor:pointer;
  border:1px solid transparent;transition:all .15s ease;
  white-space:nowrap;text-decoration:none;font-family:inherit
}
.btn-primary{background:var(--blue);color:#fff;border-color:var(--blue)}
.btn-primary:hover{filter:brightness(1.1);transform:translateY(-1px);box-shadow:0 4px 16px rgba(59,130,246,.35)}
.btn-ghost{background:transparent;color:var(--text2);border-color:var(--border2)}
.btn-ghost:hover{background:var(--card2);color:var(--text)}
.btn-danger{background:rgba(239,68,68,.1);color:var(--red);border-color:rgba(239,68,68,.25)}
.btn-danger:hover{background:rgba(239,68,68,.2)}
.btn-success{background:var(--green);color:#fff;border-color:var(--green)}
.btn-success:hover{filter:brightness(1.1)}
.btn-sm{padding:5px 10px;font-size:11px}

/* ── MAIN ── */
.main{flex:1;padding:24px 28px;display:flex;flex-direction:column;gap:20px}

/* ── STATS BAR ── */
.stats-bar{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.stat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:14px 18px;
  display:flex;flex-direction:column;gap:4px;
  position:relative;overflow:hidden;transition:border-color .2s,box-shadow .2s
}
.stat-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--accent-color,var(--blue))
}
.stat-card:hover{border-color:var(--border2);box-shadow:var(--shadow)}
.stat-label{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:.5px;text-transform:uppercase}
.stat-value{font-size:28px;font-weight:800;line-height:1;color:var(--text);font-variant-numeric:tabular-nums}
.stat-sub{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3);display:flex;align-items:center;gap:4px}
.stat-sub .up{color:var(--green)}
.stat-sub .down{color:var(--red)}

/* ── TOOLBAR ── */
.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.toolbar-left{display:flex;align-items:center;gap:10px;flex:1}
.search-box{position:relative;flex:1;max-width:320px}
.search-box input{
  width:100%;padding:8px 12px 8px 36px;
  background:var(--card);border:1px solid var(--border2);
  border-radius:6px;color:var(--text);font-size:13px;
  font-family:inherit;outline:none;transition:all .2s
}
.search-box input::placeholder{color:var(--text3)}
.search-box input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,.12)}
.search-box svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text3);pointer-events:none}
.filter-tabs{display:flex;gap:4px;background:var(--card);border:1px solid var(--border);border-radius:6px;padding:3px}
.filter-tab{
  padding:5px 12px;border-radius:4px;font-size:12px;font-weight:600;
  cursor:pointer;transition:all .15s;color:var(--text3);border:none;background:transparent;white-space:nowrap
}
.filter-tab.active{background:var(--blue);color:#fff}
.filter-tab:hover:not(.active){background:var(--card2);color:var(--text)}

/* ── TILES GRID ── */
.section-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:.6px;text-transform:uppercase}
.tiles-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.state-tile{
  background:var(--card);border:1px solid var(--border);
  border-radius:10px;padding:0;
  cursor:pointer;transition:all .22s ease;overflow:hidden;position:relative
}
.state-tile:hover{
  border-color:var(--tile-color,var(--blue));
  transform:translateY(-3px);
  box-shadow:0 10px 36px rgba(0,0,0,.28),0 0 0 1px var(--tile-color,var(--blue))
}
.tile-accent{height:3px;background:var(--tile-color,var(--blue));width:100%}
.tile-body{padding:16px}
.tile-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px}
.tile-abbr{font-size:32px;font-weight:800;letter-spacing:-1px;color:var(--tile-color,var(--blue));line-height:1}
.tile-status-badge{
  display:flex;align-items:center;gap:5px;
  padding:3px 8px;border-radius:20px;font-size:10px;font-weight:700;
  letter-spacing:.3px;text-transform:uppercase;font-family:'JetBrains Mono',monospace
}
.status-ok{background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.2)}
.status-warn{background:rgba(245,158,11,.12);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
.status-error{background:rgba(239,68,68,.12);color:var(--red);border:1px solid rgba(239,68,68,.2)}
.status-dot{width:5px;height:5px;border-radius:50%;background:currentColor}
.tile-name{font-size:13px;font-weight:700;color:var(--text);margin-bottom:2px}
.tile-dept{font-size:11px;color:var(--text3);line-height:1.4}
.tile-metrics{
  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px;
  padding-top:12px;border-top:1px solid var(--border)
}
.tile-metric{display:flex;flex-direction:column;align-items:center;gap:2px}
.tile-metric-val{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;color:var(--text);line-height:1}
.tile-metric-val.warn{color:var(--amber)}
.tile-metric-val.err{color:var(--red)}
.tile-metric-val.ok{color:var(--green)}
.tile-metric-lbl{font-size:10px;color:var(--text3);font-weight:600;text-align:center}
.tile-footer{
  padding:10px 16px;background:var(--bg3);border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between
}
.tile-ts{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);display:flex;align-items:center;gap:5px}
.tile-action-row{font-size:11px;font-weight:600;color:var(--tile-color,var(--blue));display:flex;align-items:center;gap:3px}

/* ── RUN BANNER ── */
.run-banner{
  background:linear-gradient(135deg,rgba(59,130,246,.07),rgba(6,182,212,.07));
  border:1px solid rgba(59,130,246,.18);border-radius:10px;
  padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px
}
[data-theme="light"] .run-banner{background:linear-gradient(135deg,rgba(37,99,235,.06),rgba(8,145,178,.06));border-color:rgba(37,99,235,.18)}
.run-banner-text h3{font-size:14px;font-weight:700;color:var(--text);margin-bottom:2px}
.run-banner-text p{font-size:12px;color:var(--text3)}
.run-banner-actions{display:flex;align-items:center;gap:10px}

/* ── SPINNING ── */
.spinning{animation:spin .9s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ══════════════════════════════════════════
   OVERLAY BASE (shared by all modals)
══════════════════════════════════════════ */
.modal-overlay{
  position:fixed;inset:0;background:var(--overlay-bg);
  z-index:200;opacity:0;pointer-events:none;
  transition:opacity .25s ease;backdrop-filter:blur(8px);
  display:flex;align-items:center;justify-content:center;padding:24px
}
.modal-overlay.open{opacity:1;pointer-events:all}

/* ══════════════════════════════════════════
   CENTER MODAL — DETAIL PANEL
══════════════════════════════════════════ */
.detail-modal{
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:14px;width:100%;max-width:1080px;
  max-height:88vh;display:flex;flex-direction:column;overflow:hidden;
  box-shadow:var(--shadow-lg);
  transform:scale(.94) translateY(16px);
  transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease;
  opacity:0
}
.modal-overlay.open .detail-modal{transform:scale(1) translateY(0);opacity:1}
.panel-header{
  padding:20px 24px;border-bottom:1px solid var(--border);
  display:flex;align-items:flex-start;justify-content:space-between;
  background:var(--card);flex-shrink:0;border-radius:14px 14px 0 0
}
.panel-header-left{display:flex;align-items:center;gap:14px}
.panel-state-abbr{font-size:44px;font-weight:800;line-height:1;letter-spacing:-2px;color:var(--panel-color,var(--blue))}
.panel-info h2{font-size:18px;font-weight:700;color:var(--text);margin-bottom:3px}
.panel-info p{font-size:13px;color:var(--text3)}
.panel-close{
  background:var(--card2);border:1px solid var(--border2);border-radius:6px;
  color:var(--text2);cursor:pointer;padding:8px;transition:all .15s;line-height:0;
  display:flex;align-items:center;flex-shrink:0
}
.panel-close:hover{background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.3);color:var(--red)}
.panel-stats{display:flex;gap:0;border-bottom:1px solid var(--border);flex-shrink:0;background:var(--bg3)}
.panel-stat{flex:1;padding:12px 20px;text-align:center;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:3px}
.panel-stat:last-child{border-right:none}
.panel-stat-val{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--text)}
.panel-stat-val.ok{color:var(--green)}
.panel-stat-val.warn{color:var(--amber)}
.panel-stat-val.err{color:var(--red)}
.panel-stat-lbl{font-size:10px;color:var(--text3);font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.lob-tabs-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0
}
.lob-tabs{display:flex;gap:0}
.lob-tab{
  padding:13px 18px;font-size:13px;font-weight:600;cursor:pointer;
  color:var(--text3);border-bottom:2px solid transparent;transition:all .15s;
  white-space:nowrap;border:none;background:transparent;border-bottom:2px solid transparent;font-family:inherit
}
.lob-tab:hover{color:var(--text)}
.lob-tab.active{color:var(--panel-color,var(--blue));border-bottom-color:var(--panel-color,var(--blue))}
.lob-count{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:18px;height:18px;border-radius:9px;font-size:10px;font-weight:700;
  background:rgba(0,0,0,.08);color:var(--text3);margin-left:5px;padding:0 4px
}
[data-theme="dark"] .lob-count{background:rgba(255,255,255,.08)}
.lob-tab.active .lob-count{background:rgba(59,130,246,.18);color:var(--panel-color,var(--blue))}
.panel-body{flex:1;overflow-y:auto;padding:20px 24px}

/* ── TABLE ── */
.panel-table-wrap{border:1px solid var(--border);border-radius:10px;overflow:hidden}
.panel-table{width:100%;border-collapse:collapse;font-size:13px}
.panel-table thead{background:var(--bg3)}
.panel-table th{
  padding:10px 14px;font-size:10px;font-weight:700;color:var(--text3);
  text-align:left;text-transform:uppercase;letter-spacing:.6px;
  border-bottom:1px solid var(--border);white-space:nowrap
}
.panel-table td{padding:12px 14px;border-bottom:1px solid var(--border);color:var(--text);vertical-align:middle}
.panel-table tbody tr:last-child td{border-bottom:none}
.panel-table tbody tr:hover td{background:rgba(59,130,246,.03)}
[data-theme="dark"] .panel-table tbody tr:hover td{background:rgba(255,255,255,.02)}
.sched-name{font-weight:600;color:var(--text);font-size:13px}
.sched-file{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);margin-top:2px}
.sched-size{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);opacity:.7;margin-top:1px}
.portal-badge{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600}
.portal-badge.avail{color:var(--green)}
.portal-badge.unavail{color:var(--red)}
.new-file-tag{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 8px;border-radius:20px;font-size:11px;font-weight:700;font-family:'JetBrains Mono',monospace
}
.new-yes{background:rgba(16,185,129,.1);color:var(--green);border:1px solid rgba(16,185,129,.2)}
.new-no{background:rgba(100,116,139,.08);color:var(--text3);border:1px solid var(--border)}
.comp-tag{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;white-space:nowrap;font-family:'JetBrains Mono',monospace
}
.comp-changes{background:rgba(245,158,11,.1);color:var(--amber)}
.comp-matched{background:rgba(16,185,129,.1);color:var(--green)}
.comp-pending{background:rgba(139,92,246,.1);color:var(--purple)}
.comp-na{background:rgba(100,116,139,.07);color:var(--text3)}
.changes-count{font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--amber)}
.changes-none{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text3)}
.dl-btn{
  display:inline-flex;align-items:center;gap:5px;
  padding:5px 9px;border-radius:6px;font-size:11px;font-weight:700;
  cursor:pointer;border:none;transition:all .15s;text-decoration:none;font-family:inherit
}
.dl-diff{background:rgba(245,158,11,.12);color:var(--amber);border:1px solid rgba(245,158,11,.22)}
.dl-diff:hover{background:rgba(245,158,11,.22);transform:translateY(-1px)}
.dl-orig{background:rgba(59,130,246,.1);color:var(--blue);border:1px solid rgba(59,130,246,.18)}
.dl-orig:hover{background:rgba(59,130,246,.2);transform:translateY(-1px)}
.dl-none{color:var(--text3);font-size:11px;font-style:italic}
.run-btn{
  padding:5px 9px;border-radius:6px;font-size:11px;font-weight:600;
  cursor:pointer;border:1px solid var(--border2);background:transparent;color:var(--text2);
  transition:all .15s;display:inline-flex;align-items:center;gap:4px;font-family:inherit
}
.run-btn:hover{border-color:var(--blue);color:var(--blue);background:rgba(59,130,246,.07)}
.ts-cell{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3)}

/* ══════════════════════════════════════════
   SCHEDULE CONFIG MODAL
══════════════════════════════════════════ */
.schedule-modal{
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:14px;width:100%;max-width:900px;
  max-height:90vh;display:flex;flex-direction:column;overflow:hidden;
  box-shadow:var(--shadow-lg);
  transform:scale(.94) translateY(16px);
  transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease;
  opacity:0
}
.modal-overlay.open .schedule-modal{transform:scale(1) translateY(0);opacity:1}
.sched-modal-header{
  padding:20px 24px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  background:var(--card);flex-shrink:0;border-radius:14px 14px 0 0
}
.sched-modal-title{display:flex;align-items:center;gap:12px}
.sched-modal-title h2{font-size:17px;font-weight:700;color:var(--text)}
.sched-modal-title p{font-size:12px;color:var(--text3);margin-top:2px}
.sched-modal-icon{
  width:40px;height:40px;background:rgba(59,130,246,.12);border-radius:10px;
  display:flex;align-items:center;justify-content:center;color:var(--blue);flex-shrink:0
}
.sched-modal-body{flex:1;overflow-y:auto;padding:0}
.sched-global-bar{
  display:grid;grid-template-columns:repeat(3,1fr);gap:0;
  border-bottom:1px solid var(--border);background:var(--bg3)
}
.sched-global-item{
  padding:14px 20px;border-right:1px solid var(--border);
  display:flex;flex-direction:column;gap:6px
}
.sched-global-item:last-child{border-right:none}
.sched-global-lbl{font-size:11px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.4px}
.sched-global-ctrl{display:flex;align-items:center;gap:8px}
.form-select,.form-input{
  background:var(--card);border:1px solid var(--border2);
  border-radius:6px;color:var(--text);padding:7px 10px;font-size:13px;
  font-family:inherit;outline:none;transition:border-color .2s;cursor:pointer
}
.form-select:focus,.form-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(59,130,246,.1)}
.form-input[type="time"]{font-family:'JetBrains Mono',monospace}
.sched-table-section{padding:16px 24px 24px}
.sched-section-hdr{
  display:flex;align-items:center;justify-content:space-between;margin-bottom:12px
}
.sched-section-hdr h3{font-size:13px;font-weight:700;color:var(--text)}
.sched-section-hdr p{font-size:12px;color:var(--text3)}
.sched-table{width:100%;border-collapse:collapse;font-size:13px}
.sched-table thead{background:var(--bg3)}
.sched-table th{
  padding:9px 14px;font-size:10px;font-weight:700;color:var(--text3);
  text-align:left;text-transform:uppercase;letter-spacing:.5px;
  border-bottom:1px solid var(--border);white-space:nowrap
}
.sched-table td{
  padding:11px 14px;border-bottom:1px solid var(--border);
  color:var(--text);vertical-align:middle
}
.sched-table tbody tr:last-child td{border-bottom:none}
.sched-table tbody tr:hover td{background:rgba(59,130,246,.03)}
[data-theme="dark"] .sched-table tbody tr:hover td{background:rgba(255,255,255,.02)}
.sched-table-wrap{border:1px solid var(--border);border-radius:10px;overflow:hidden}

/* Toggle Switch */
.toggle-sw{position:relative;width:38px;height:22px;flex-shrink:0}
.toggle-sw input{opacity:0;width:0;height:0}
.toggle-sw .slider{
  position:absolute;inset:0;background:var(--border2);border-radius:11px;
  cursor:pointer;transition:background .2s
}
.toggle-sw .slider::before{
  content:'';position:absolute;width:16px;height:16px;border-radius:50%;
  background:#fff;left:3px;top:3px;transition:transform .2s;box-shadow:0 1px 4px rgba(0,0,0,.2)
}
.toggle-sw input:checked+.slider{background:var(--green)}
.toggle-sw input:checked+.slider::before{transform:translateX(16px)}

/* Days checkboxes */
.days-row{display:flex;gap:5px;flex-wrap:wrap}
.day-cb{display:none}
.day-lbl{
  display:inline-flex;align-items:center;justify-content:center;
  width:30px;height:24px;border-radius:5px;font-size:11px;font-weight:700;
  cursor:pointer;transition:all .15s;border:1px solid var(--border2);color:var(--text3);
  font-family:'JetBrains Mono',monospace;user-select:none
}
.day-cb:checked+.day-lbl{background:var(--blue);color:#fff;border-color:var(--blue)}

/* Frequency badge */
.freq-badge{
  display:inline-flex;align-items:center;padding:3px 8px;
  border-radius:4px;font-size:11px;font-weight:700;font-family:'JetBrains Mono',monospace;
  background:rgba(139,92,246,.1);color:var(--purple)
}
.sched-state-abbr{
  font-size:18px;font-weight:800;color:var(--text);letter-spacing:-.5px;
  display:flex;align-items:center;gap:8px
}
.sched-state-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.sched-modal-footer{
  padding:16px 24px;border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  background:var(--card);flex-shrink:0;gap:12px
}
.sched-footer-note{font-size:12px;color:var(--text3);display:flex;align-items:center;gap:6px}

/* ── ACTIVITY LOG ── */
.activity-row{
  display:flex;align-items:center;gap:10px;padding:9px 0;
  border-bottom:1px solid var(--border);font-size:12px
}
.activity-row:last-child{border-bottom:none}
.activity-icon{
  width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0
}
.act-green{background:rgba(16,185,129,.1);color:var(--green)}
.act-amber{background:rgba(245,158,11,.1);color:var(--amber)}
.act-blue{background:rgba(59,130,246,.1);color:var(--blue)}
.act-red{background:rgba(239,68,68,.1);color:var(--red)}
.activity-text{flex:1;color:var(--text2)}
.activity-text strong{color:var(--text);font-weight:700}
.activity-ts{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);white-space:nowrap}

/* ── EMPTY ── */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:48px;color:var(--text3)}
.empty p{font-size:14px;font-weight:500}

/* ── TOASTS ── */
.toast-container{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;gap:10px}
.toast{
  display:flex;align-items:center;gap:10px;padding:12px 16px;
  border-radius:10px;border:1px solid;min-width:300px;
  box-shadow:var(--shadow-lg);animation:slideUp .25s ease;font-size:13px;font-weight:500
}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:none;opacity:1}}
.toast-success{background:var(--card);border-color:rgba(16,185,129,.35);color:var(--green)}
.toast-warn{background:var(--card);border-color:rgba(245,158,11,.35);color:var(--amber)}
.toast-info{background:var(--card);border-color:rgba(59,130,246,.35);color:var(--blue)}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .stats-bar{grid-template-columns:repeat(3,1fr)}
  .tiles-grid{grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
}
@media(max-width:700px){
  .main{padding:14px}
  .topbar{padding:0 14px}
  .stats-bar{grid-template-columns:repeat(2,1fr)}
  .modal-overlay{padding:12px}
  .panel-table{font-size:11px}
  .sched-global-bar{grid-template-columns:1fr}
  .sched-global-item{border-right:none;border-bottom:1px solid var(--border)}
}
</style>
</head>
<body>
<div class="shell">

<!-- ═══ TOP BAR ═══ -->
<header class="topbar">
