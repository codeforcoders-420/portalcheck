// ── STATE VARS ─────────────────────────────────
let currentFilter='all',currentState=null,currentLob=null;

function stateSummary(s){
  const all=s.lobs.flatMap(l=>l.schedules);
  const newFiles=all.filter(x=>x.newFile).length;
  const changes=all.filter(x=>x.compStatus==='changes').length;
  const unavail=all.filter(x=>!x.portal).length;
  const total=all.length;
  let tileStatus='ok';
  if(changes>0)tileStatus='warn';
  if(unavail===total)tileStatus='error';
  return{newFiles,changes,unavail,total,tileStatus};
}
function statusLabel(s){return s==='warn'?'Changes Found':s==='error'?'Unavailable':'All Clear';}

// ── RENDER TILES ───────────────────────────────
function renderTiles(){
  const q=document.getElementById('search-input').value.toLowerCase();
  const sort=document.getElementById('sort-sel').value;
  let list=[...STATES];
  if(q)list=list.filter(s=>s.name.toLowerCase().includes(q)||s.id.toLowerCase().includes(q));
  if(currentFilter==='changes')list=list.filter(s=>stateSummary(s).changes>0);
  if(currentFilter==='ok')list=list.filter(s=>stateSummary(s).changes===0);
  if(currentFilter==='error')list=list.filter(s=>stateSummary(s).unavail>0);
  if(sort==='changes')list.sort((a,b)=>stateSummary(b).changes-stateSummary(a).changes);
  else if(sort==='status'){const o={warn:0,error:1,ok:2};list.sort((a,b)=>o[stateSummary(a).tileStatus]-o[stateSummary(b).tileStatus]);}
  else list.sort((a,b)=>a.name.localeCompare(b.name));
  const grid=document.getElementById('tiles-grid');
  if(!list.length){
    grid.innerHTML=`<div class="empty" style="grid-column:1/-1">${ico('eye',32)}<p>No portals match your filter</p></div>`;
    return;
  }
  grid.innerHTML=list.map(s=>{
    const{newFiles,changes,unavail,tileStatus,total}=stateSummary(s);
    const sc=tileStatus==='warn'?'status-warn':tileStatus==='error'?'status-error':'status-ok';
    const vc=changes>0?'warn':unavail>0?'err':'ok';
    return `<div class="state-tile" style="--tile-color:${s.color}" onclick="openDetailModal('${s.id}')">
      <div class="tile-accent"></div>
      <div class="tile-body">
        <div class="tile-header">
          <div class="tile-abbr">${s.id}</div>
          <div class="tile-status-badge ${sc}"><div class="status-dot"></div>${statusLabel(tileStatus)}</div>
        </div>
        <div class="tile-name">${s.name}</div>
        <div class="tile-dept">${s.dept}</div>
        <div class="tile-metrics">
          <div class="tile-metric"><div class="tile-metric-val">${total}</div><div class="tile-metric-lbl">Schedules</div></div>
          <div class="tile-metric"><div class="tile-metric-val ${newFiles>0?'warn':''}">${newFiles}</div><div class="tile-metric-lbl">New Files</div></div>
          <div class="tile-metric"><div class="tile-metric-val ${vc}">${changes}</div><div class="tile-metric-lbl">Changes</div></div>
        </div>
      </div>
      <div class="tile-footer">
        <div class="tile-ts">${ico('clock',10)}&nbsp;${s.lastChecked}</div>
        <div class="tile-action-row">${ico('eye',11)}&nbsp;View Details</div>
      </div>
    </div>`;
  }).join('');
}

function setFilter(f,el){
  currentFilter=f;
  document.querySelectorAll('.filter-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderTiles();
}

// ── DETAIL MODAL ───────────────────────────────
function openDetailModal(id){
  const s=STATES.find(x=>x.id===id);if(!s)return;
  currentState=s;
  document.getElementById('detail-modal').style.setProperty('--panel-color',s.color);
  document.getElementById('panel-abbr').textContent=s.id;
  document.getElementById('panel-name').textContent=s.name;
  document.getElementById('panel-dept').textContent=s.dept;
  const all=s.lobs.flatMap(l=>l.schedules);
  document.getElementById('ps-total').textContent=all.length;
  document.getElementById('ps-avail').textContent=all.filter(x=>x.portal).length;
  document.getElementById('ps-new').textContent=all.filter(x=>x.newFile).length;
  document.getElementById('ps-changes').textContent=all.filter(x=>x.compStatus==='changes').length;
  document.getElementById('ps-lobs').textContent=s.lobs.length;
  currentLob=s.lobs[0].id;
  document.getElementById('lob-tabs').innerHTML=s.lobs.map(l=>`
    <button class="lob-tab${l.id===currentLob?' active':''}" onclick="switchLob('${l.id}',this)">
      ${l.name}<span class="lob-count">${l.schedules.length}</span>
    </button>`).join('');
  renderPanelTable(s,currentLob);
  openModal('detail-overlay');
}

function switchLob(lobId,el){
  currentLob=lobId;
  document.querySelectorAll('.lob-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  renderPanelTable(currentState,lobId);
}

function renderPanelTable(s,lobId){
  const lob=s.lobs.find(l=>l.id===lobId);if(!lob)return;
  const rows=lob.schedules.map(sch=>{
    const pH=sch.portal?`<span class="portal-badge avail">${ico('check',12)} Available</span>`:`<span class="portal-badge unavail">${ico('x',12)} Unavailable</span>`;
    const nH=sch.newFile?`<span class="new-file-tag new-yes">${ico('check',10)} ${sch.newDate}</span>`:`<span class="new-file-tag new-no">— None</span>`;
    const cs=sch.compStatus;
    let cH='';
    if(cs==='changes')cH=`<span class="comp-tag comp-changes">${ico('alert',10)} Changes</span>`;
    else if(cs==='matched')cH=`<span class="comp-tag comp-matched">${ico('check',10)} Matched</span>`;
    else if(cs==='pending')cH=`<span class="comp-tag comp-pending">${ico('clock',10)} Pending</span>`;
    else cH=`<span class="comp-tag comp-na">N/A</span>`;
    const chH=cs==='changes'?`<span class="changes-count">+${sch.changes.toLocaleString()}</span>`:`<span class="changes-none">—</span>`;
    const dH=sch.diffFile?`<button class="dl-btn dl-diff" onclick="dlFile('${sch.diffFile}','diff')">${ico('dl',10)} Diff</button>`:`<span class="dl-none">—</span>`;
    const sH=sch.portal?`<button class="dl-btn dl-orig" onclick="dlFile('${sch.file}','source')">${ico('dl',10)} Source</button>`:`<span class="dl-none">N/A</span>`;
    return `<tr>
      <td class="col-schedule"><div class="sched-name">${sch.name}</div><div class="sched-file">${sch.file}</div>${sch.fileSize?`<div class="sched-size">${sch.fileSize}</div>`:''}</td>
      <td class="col-portal">${pH}</td>
      <td class="col-ts ts-cell">${s.lastChecked}</td>
      <td class="col-newfile">${nH}</td>
      <td class="col-comp">${cH}</td>
      <td class="col-chg">${chH}</td>
      <td class="col-diff">${dH}</td>
      <td class="col-src">${sH}</td>
      <td class="col-action"><button class="run-btn" onclick="runSingleCheck(this,'${sch.id}')">${ico('refresh',10)} Check</button></td>
    </tr>`;
  }).join('');
  document.getElementById('panel-body').innerHTML=`
    <div class="panel-table-wrap">
      <table class="panel-table">
        <thead><tr>
          <th class="col-schedule">Fee Schedule</th>
          <th class="col-portal">Portal</th>
          <th class="col-ts">Last Checked</th>
          <th class="col-newfile">New File</th>
          <th class="col-comp">Comparison</th>
          <th class="col-chg"># Changes</th>
          <th class="col-diff">Diff File</th>
          <th class="col-src">Source</th>
          <th class="col-action">Action</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
}

function closeDetailModal(){closeModal('detail-overlay');currentState=null;}

// ── SCHEDULE MODAL ─────────────────────────────
const DAYS=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
const FREQS=[{val:'hourly',label:'Every 6 Hours'},{val:'twice',label:'Twice Daily'},{val:'daily',label:'Daily'},{val:'weekdays',label:'Weekdays Only'},{val:'weekly',label:'Weekly'},{val:'monthly',label:'Monthly'}];

function nextRunLabel(cfg){
  if(!cfg.enabled)return'Disabled';
  const[h,m]=cfg.time.split(':').map(Number);
  const now=new Date(),next=new Date();
  next.setHours(h,m,0,0);
  if(next<=now)next.setDate(next.getDate()+1);
  const diff=Math.round((next-now)/60000);
  return diff<60?`in ${diff}m`:`in ${Math.floor(diff/60)}h ${diff%60}m`;
}

function openScheduleModal(){renderSchedTable();openModal('schedule-overlay');}
function closeScheduleModal(){closeModal('schedule-overlay');}

function renderSchedTable(){
  document.getElementById('sched-table-body').innerHTML=STATES.map(s=>{
    const cfg=schedConfig[s.id];
    const daysCbs=DAYS.map(d=>`<input type="checkbox" class="day-cb" id="day-${s.id}-${d}" ${cfg.days.includes(d)?'checked':''} onchange="updateDay('${s.id}','${d}',this.checked)"><label class="day-lbl" for="day-${s.id}-${d}" title="${d}">${d[0]}</label>`).join('');
    const freqOpts=FREQS.map(f=>`<option value="${f.val}" ${cfg.freq===f.val?'selected':''}>${f.label}</option>`).join('');
    return `<tr>
      <td><div class="sched-state-abbr"><span class="sched-state-dot" style="background:${s.color}"></span><strong>${s.id}</strong><span class="sched-state-name">${s.name}</span></div></td>
      <td><label class="toggle-sw"><input type="checkbox" ${cfg.enabled?'checked':''} onchange="updateEnabled('${s.id}',this.checked)"><span class="slider"></span></label></td>
      <td><select class="form-select" style="font-size:12px;padding:5px 8px;width:100%" onchange="updateFreq('${s.id}',this.value)">${freqOpts}</select></td>
      <td><input type="time" class="form-input" value="${cfg.time}" style="font-size:12px;padding:5px 8px;width:100%" onchange="updateTime('${s.id}',this.value)"></td>
      <td><div class="days-row">${daysCbs}</div></td>
      <td><input type="email" class="form-input" value="${cfg.email}" placeholder="notify@org.com" style="font-size:12px;padding:5px 8px;width:100%" onchange="updateEmail('${s.id}',this.value)"></td>
      <td><span class="freq-badge">${nextRunLabel(cfg)}</span></td>
    </tr>`;
  }).join('');
}

function updateEnabled(id,val){schedConfig[id].enabled=val;}
function updateFreq(id,val){schedConfig[id].freq=val;}
function updateTime(id,val){schedConfig[id].time=val;}
function updateEmail(id,val){schedConfig[id].email=val;}
function updateDay(id,day,checked){
  const days=schedConfig[id].days;
  if(checked&&!days.includes(day))days.push(day);
  if(!checked)schedConfig[id].days=days.filter(d=>d!==day);
}
function applyGlobalFreq(){const v=document.getElementById('global-freq').value;STATES.forEach(s=>schedConfig[s.id].freq=v);}
function applyGlobalTime(){const v=document.getElementById('global-time').value;STATES.forEach(s=>schedConfig[s.id].time=v);}
function applyGlobalToAll(){applyGlobalFreq();applyGlobalTime();renderSchedTable();showToast('Global settings applied to all 11 portals.','info');}
function toggleAllPortals(checked){STATES.forEach(s=>schedConfig[s.id].enabled=checked);document.querySelectorAll('#sched-table-body .toggle-sw input').forEach(cb=>cb.checked=checked);}
function saveSchedule(){
  closeScheduleModal();
  const n=STATES.filter(s=>schedConfig[s.id].enabled).length;
  showToast(`Schedule saved — ${n} of 11 portals active.`,'info');
  addActivity(`<strong>Schedule updated</strong> — ${n} portals active`,'blue');
}

// ── MODAL HELPERS ──────────────────────────────
function openModal(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id).classList.remove('open');document.body.style.overflow='';}
function handleOverlayClick(e,id){
  if(e.target.id===id){if(id==='detail-overlay')closeDetailModal();else if(id==='schedule-overlay')closeScheduleModal();}
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeDetailModal();closeScheduleModal();}});

// ── ACTIONS ────────────────────────────────────
function dlFile(fname,type){showToast(`${type==='diff'?'Diff':'Source'} download started: ${fname}`,'info');}
function runSingleCheck(btn,id){
  btn.disabled=true;
  btn.innerHTML=`<svg class="spinning" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Checking…`;
  setTimeout(()=>{btn.disabled=false;btn.innerHTML=`${ico('refresh',10)} Check`;showToast('Check complete — no new file detected.','info');},2200);
}
function runStateCheck(){if(!currentState)return;showToast(`Running check on ${currentState.name}…`,'info');setTimeout(()=>showToast(`${currentState.name} check complete.`,'info'),3000);}
function runAllChecks(){
  const icon=document.getElementById('run-all-icon');
  icon.classList.add('spinning');
  showToast('Running full check on all 11 portals…','info');
  STATES.forEach((s,i)=>{
    setTimeout(()=>{
      const{changes,newFiles,unavail}=stateSummary(s);
      addActivity(`<strong>${s.id} (${s.name})</strong> — ${newFiles} new file(s) · ${changes} change(s)`,changes>0?'amber':unavail>0?'red':'green');
    },i*300);
  });
  setTimeout(()=>{icon.classList.remove('spinning');showToast('All 11 portals checked — 8 changes detected.','warn');},STATES.length*300+400);
}

// ── ACTIVITY ───────────────────────────────────
const activities=[
  {text:'<strong>CMS</strong> — Medicare Physician Fee Schedule diff generated · 2,841 changes',type:'amber',ts:'08:42 AM'},
  {text:'<strong>GA</strong> — Outpatient Hospital new file downloaded · comparison running',type:'blue',ts:'08:38 AM'},
  {text:'<strong>NV</strong> — Pharmacy MAC Pricing updated · 512 line changes',type:'amber',ts:'08:35 AM'},
  {text:'<strong>MI</strong> — Physician Fee Schedule diff complete · 847 changes',type:'amber',ts:'08:31 AM'},
  {text:'<strong>OH</strong> — Physician Fee Schedule new file found · Q3 2026',type:'green',ts:'08:30 AM'},
  {text:'<strong>WI</strong> — ForwardHealth DMEPOS updated · 88 changes',type:'amber',ts:'08:30 AM'},
  {text:'<strong>MS</strong> — Inpatient DRG Rates comparison complete · 76 changes',type:'amber',ts:'08:28 AM'},
  {text:'<strong>TC</strong> — TennCare Physician new version found · check initiated',type:'blue',ts:'08:26 AM'},
];
function addActivity(text,type){
  activities.unshift({text,type,ts:new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})});
  renderActivity();
}
function renderActivity(){
  const tm={green:'act-green',amber:'act-amber',blue:'act-blue',red:'act-red'};
  const im={green:ico('check',13),amber:ico('alert',13),blue:ico('file',13),red:ico('x',13)};
  document.getElementById('activity-log').innerHTML=activities.slice(0,10).map(a=>`
    <div class="activity-row">
      <div class="activity-icon ${tm[a.type]||'act-blue'}">${im[a.type]||''}</div>
      <div class="activity-text">${a.text}</div>
      <div class="activity-ts">${a.ts}</div>
    </div>`).join('');
}

// ── TOAST ──────────────────────────────────────
function showToast(msg,type='info'){
  const tc=document.getElementById('toast-container');
  const t=document.createElement('div');
  const cls=type==='warn'?'toast-warn':type==='info'?'toast-info':'toast-success';
  const ic=type==='warn'?ico('alert',15):type==='info'?ico('file',15):ico('check',15);
  t.className=`toast ${cls}`;
  t.innerHTML=`${ic}<span>${msg}</span>`;
  tc.prepend(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateY(10px)';t.style.transition='all .3s';setTimeout(()=>t.remove(),300);},4500);
}

// ── CLOCK ──────────────────────────────────────
function updateClock(){
  document.getElementById('live-clock').textContent=new Date().toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
setInterval(updateClock,1000);
updateClock();

// ── INIT ───────────────────────────────────────
renderTiles();
renderActivity();
</script>
</body>
