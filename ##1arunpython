    </svg>
    <span class="topbar-title">State Portal Monitor</span>
    <span class="topbar-badge">FEE SCHEDULES</span>
  </div>
  <div class="topbar-right">
    <div class="topbar-clock">
      <span class="pulse-dot"></span>
      <span id="live-clock">—</span>
    </div>
    <div class="theme-toggle" onclick="toggleTheme()" title="Toggle light / dark mode" role="button">
