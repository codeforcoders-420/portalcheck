function addActivity(text,type){
  activities.unshift({text,type,ts:new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})});
  renderActivity();
}
function renderActivity(){
  const typeMap={green:'act-green',amber:'act-amber',blue:'act-blue',red:'act-red'};
  const iconMap={green:ico('check',13),amber:ico('alert',13),blue:ico('file',13),red:ico('x',13)};
  document.getElementById('activity-log').innerHTML=activities.slice(0,10).map(a=>`
    <div class="activity-row">
      <div class="activity-icon ${typeMap[a.type]||'act-blue'}">${iconMap[a.type]||''}</div>
      <div class="activity-text">${a.text}</div>
      <div class="activity-ts">${a.ts}</div>
    </div>`).join('');
}

// ═══════════════════════════════════════
// TOAST
// ═══════════════════════════════════════
function showToast(msg, type='info'){
  const tc = document.getElementById('toast-container');
  const t = document.createElement('div');
  const cls = type==='warn'?'toast-warn':type==='info'?'toast-info':'toast-success';
  const ic = type==='warn'?ico('alert',15):type==='info'?ico('file',15):ico('check',15);
  t.className=`toast ${cls}`;
  t.innerHTML=`${ic}<span>${msg}</span>`;
  tc.prepend(t);
  setTimeout(()=>{ t.style.opacity='0'; t.style.transform='translateY(12px)'; t.style.transition='all .3s'; setTimeout(()=>t.remove(),300); },4500);
}

